<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Csms.Domain\Csms.Domain.csproj" />
    <ProjectReference Include="..\Csms.Application\Csms.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Версии 9.0.* — под net9.0; 11.x на этой цели не собирается -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.0" />
    <!-- Рендер сканов PDF в растр: pdfium, без системных зависимостей -->
    <PackageReference Include="Docnet.Core" Version="2.1.2" />
    <!-- Разбор .docx: таблицы перечней и сноски -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Эталон пула 158н: используется один раз, когда версии ещё нет в БД -->
    <EmbeddedResource Include="Seeds/order158n-pool.json"
                      LogicalName="Csms.Infrastructure.Seeds.order158n-pool.json" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
