<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Csms.Domain\Csms.Domain.csproj" />
    <ProjectReference Include="..\Csms.Application\Csms.Application.csproj" />
    <ProjectReference Include="..\Csms.Infrastructure\Csms.Infrastructure.csproj" />
    <!-- Ядро генератора документации: API строит каталог XSD при обновлении схем -->
    <ProjectReference Include="..\..\tools\EisDocGenerator.Core\EisDocGenerator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Закоммиченные XSD должны лежать рядом со сборкой: EisSchemaCatalog
         по умолчанию ищет schemas/<версия> в BaseDirectory. Без явного
         копирования чистая сборка не находит схемы и валидация XML молча
         пропускается. Промежуточную выгрузку .incoming не переносим. -->
    <Content Include="..\..\schemas\**\*"
             Exclude="..\..\schemas\.incoming\**\*;..\..\schemas\README.md"
             Link="schemas\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.0" />
    <!-- Для dotnet-ef: миграции, создание которых происходит через дизайн-тайм контекст -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <PrivateAssets>build</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Локальные строки подключения и пароли живут в user-secrets,
         а не в репозитории -->
    <UserSecretsId>8f3b1d27-6c44-4e9a-9d51-2a7c0e5b61aa</UserSecretsId>
  </PropertyGroup>

</Project>
